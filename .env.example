# ==============================================================================
# Exchange 連線（Spot，真正落單嘅地方）
# ==============================================================================
# 落單必填（就算 USE_TESTNET=true 都要）。Testnet 金鑰請去
# https://testnet.binance.vision/ 用 GitHub 帳號登入生成。
API_KEY=
API_SECRET=

# true = Spot Testnet（模擬資金）；false = 正式帳戶（真實資金）
USE_TESTNET=true

# ==============================================================================
# 監控目標（funding rate 讀自 Binance Futures 正式網公開數據，唔受呢個影響）
# ==============================================================================
SYMBOL=BTC/USDT

# ==============================================================================
# Funding Squeeze 策略參數（已用兩個獨立engine驗證：z<-2.0/hold=6/冇止損，
# PF 1.63-1.74，train/test都>1——唔好隨便改，改咗要重新驗證）
# ==============================================================================
Z_WINDOW=540
Z_ENTRY_THRESHOLD=-2.0
HOLD_PERIODS=6

# 每筆交易用可用資金嘅幾多%（0.25=25%）。Backtest驗證用嘅係100%全倉，
# 呢度預設保守啲，減低單一筆對成副資金嘅波動；每筆%回報同backtest一致。
POSITION_SIZE_FRACTION=0.25

# 輪詢間隔（秒）——因為訊號每8小時先變一次，唔需要好密
POLL_INTERVAL_SECONDS=300

# ==============================================================================
# Telegram 通知
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
